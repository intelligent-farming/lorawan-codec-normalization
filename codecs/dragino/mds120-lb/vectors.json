{
  "uplink": [
    {
      "description": "fPort 2 telemetry: 0.257 m LiDAR distance, 1.2 C probe temp, 3.318 V",
      "input": {
        "fPort": 2,
        "bytes": [12, 246, 1, 1, 3, 0, 12, 1, 221, 1, 255]
      },
      "expected": {
        "data": {
          "battery": 3.318,
          "tank": { "distance": 0.257 },
          "interruptFlag": true,
          "temperature": 1.2,
          "sensorFlag": true,
          "make": "dragino",
          "model": "mds120-lb"
        }
      },
      "source": "ttn-example"
    },
    {
      "description": "unsupported fPort returns an error",
      "input": {
        "fPort": 42,
        "bytes": [12, 246, 1, 1, 3, 0, 12, 1]
      },
      "expected": {
        "errors": ["unsupported fPort"]
      },
      "source": "synthetic"
    }
  ],
  "downlink": []
}
