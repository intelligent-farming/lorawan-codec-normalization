{
  "uplink": [
    {
      "description": "Alarm: service buttons 1 and 3 pressed (synthetic: opcode 1, mask 0x05, 3.50 V)",
      "input": {
        "fPort": 1,
        "bytes": [1, 1, 94, 1, 5]
      },
      "expected": {
        "data": {
          "make": "mutelcor",
          "model": "mtc-scb01",
          "payloadVersion": 1,
          "battery": 3.5,
          "opcode": 1,
          "buttons": [1, 3],
          "action": { "button": { "pressed": true, "event": "single", "count": 2 } }
        }
      },
      "source": "synthetic"
    },
    {
      "description": "Heartbeat, no press (synthetic: opcode 0)",
      "input": {
        "fPort": 1,
        "bytes": [1, 1, 94, 0]
      },
      "expected": {
        "data": {
          "make": "mutelcor",
          "model": "mtc-scb01",
          "payloadVersion": 1,
          "battery": 3.5,
          "opcode": 0,
          "action": { "button": { "pressed": false } }
        }
      },
      "source": "synthetic"
    },
    {
      "description": "Switch opcode carries no press and returns an error",
      "input": {
        "fPort": 1,
        "bytes": [1, 1, 94, 6, 1]
      },
      "expected": { "errors": ["unsupported opcode 6"] },
      "source": "synthetic"
    }
  ],
  "downlink": []
