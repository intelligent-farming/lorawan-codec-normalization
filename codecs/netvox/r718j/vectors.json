{
  "uplink": [
    {
      "description": "Status report: 3.0 V, contact closed",
      "input": {
        "fPort": 6,
        "bytes": [1, 33, 1, 30, 1, 0, 0, 0, 0, 0, 0]
      },
      "expected": {
        "data": {
          "make": "netvox",
          "model": "r718j",
          "battery": 3.0,
          "action": { "contactState": "closed" }
        }
      },
      "source": "ttn-example",
      "_note": "TTN example status report (netvox r718j codec yaml, Apache-2.0). Upstream oracle: Volt 3, status 1. byte3 0x1E=30 -> 3.0 V; byte4=1 (non-zero) -> action.contactState 'closed'."
    },
    {
      "description": "Synthetic in-bounds report: contact open (status 0)",
      "input": {
        "fPort": 6,
        "bytes": [1, 33, 1, 36, 0, 0, 0, 0, 0, 0, 0]
      },
      "expected": {
        "data": {
          "make": "netvox",
          "model": "r718j",
          "battery": 3.6,
          "action": { "contactState": "open" }
        }
      },
      "source": "synthetic",
      "_note": "Synthetic open-contact case. byte3 0x24 -> 3.6 V; byte4=0 -> action.contactState 'open'."
    },
    {
      "description": "Startup version frame (report type 0x00) carries no measurement",
      "input": {
        "fPort": 6,
        "bytes": [1, 33, 0, 100, 11, 32, 32, 4, 36, 0, 0]
      },
      "expected": {
        "errors": ["device information frame"]
      },
      "source": "ttn-example",
      "_note": "TTN example startup version report (byte2 == 0x00). No measurement."
    },
    {
      "description": "Configuration response on fPort 7 carries no measurement",
      "input": {
        "fPort": 7,
        "bytes": [129, 33, 0, 0, 0, 0, 0, 0, 0, 0, 0]
      },
      "expected": {
        "errors": ["unsupported fPort 7"]
      },
      "source": "ttn-example",
      "_note": "TTN example ConfigReportRsp on fPort 7."
    }
  ],
  "downlink": []
