{
  "uplink": [
    {
      "description": "Status report, input 2 pressed (TTN example bytes)",
      "input": {
        "fPort": 6,
        "bytes": [1, 72, 1, 36, 0, 1, 0, 0, 0, 0, 0]
      },
      "expected": {
        "data": {
          "make": "netvox",
          "model": "r718t2",
