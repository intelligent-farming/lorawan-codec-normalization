{
  "uplink": [
    {
      "description": "counters 1 & 2: cumulative indices 1000 and 2000 (meter0/meter1)",
      "input": { "fPort": 1, "bytes": [80, 0, 0, 3, 232, 0, 0, 7, 208] },
      "expected": {
        "data": {
          "make": "atim", "model": "acw-mr2-ex",
          "frameType": "counters",
          "channels": [
            { "channel": "meter0", "pulse": { "total": 1000 } },
            { "channel": "meter1", "pulse": { "total": 2000 } }
          ]
        }
      },
      "source": "synthetic",
      "_note": "0x50 'compteur 1 et 2'. c1=0x000003E8=1000, c2=0x000007D0=2000. Verified against reference/upstream-codec.js (compteur1=1000, compteur2=2000); upstream's 1-based compteur1/2 are physical positions 0/1 -> meter0/meter1."
    },
    {
      "description": "standard meter frame: wire-cut clear, indices 1000 and 2000",
      "input": { "fPort": 1, "bytes": [20, 0, 0, 0, 3, 232, 0, 0, 7, 208] },
      "expected": {
        "data": {
          "make": "atim", "model": "acw-mr2-ex",
          "wireCut": false,
          "frameType": "meter",
          "channels": [
            { "channel": "meter0", "pulse": { "total": 1000 } },
            { "channel": "meter1", "pulse": { "total": 2000 } }
          ]
        }
      },
      "source": "synthetic",
      "_note": "0x14 'compteur standard': wirecut byte 0, c1=1000, c2=2000. Verified against reference/upstream-codec.js (wirecut=0, compteur1=1000, compteur2=2000). wireCut is whole-device, so it stays top-level."
    },
    {
      "description": "digital-input (Boolean) mode: input0 closed, inputs 1-15 open",
      "input": { "fPort": 1, "bytes": [66, 1, 0] },
