          "make": "atim", "model": "acw-mr2-ex",
          "frameType": "digitalInputs",
          "channels": [
            { "channel": "input0", "action": { "contactState": "closed" } },
            { "channel": "input1", "action": { "contactState": "open" } },
            { "channel": "input2", "action": { "contactState": "open" } },
            { "channel": "input3", "action": { "contactState": "open" } },
            { "channel": "input4", "action": { "contactState": "open" } },
            { "channel": "input5", "action": { "contactState": "open" } },
            { "channel": "input6", "action": { "contactState": "open" } },
