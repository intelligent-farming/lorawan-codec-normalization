      "source": "synthetic",
      "_note": "0x42 'entrees digitales'. entree byte 0x01 -> bit0 set. Verified against reference/upstream-codec.js (entree [1,0,...]). The frame always carries 16 bits regardless of variant, so 16 entries are emitted (see codec header limitation)."
    },
    {
      "description": "multi-position: inputs + both meter indices in one frame (0x5E)",
      "input": { "fPort": 1, "bytes": [94, 5, 128, 0, 0, 0, 100, 0, 0, 0, 200] },
      "expected": {
        "data": {
          "make": "atim", "model": "acw-mr2-ex",
          "frameType": "inputsCounters",
          "channels": [
            { "channel": "input0", "action": { "contactState": "closed" } },
            { "channel": "input1", "action": { "contactState": "open" } },
            { "channel": "input2", "action": { "contactState": "closed" } },
            { "channel": "input3", "action": { "contactState": "open" } },
            { "channel": "input4", "action": { "contactState": "open" } },
            { "channel": "input5", "action": { "contactState": "open" } },
