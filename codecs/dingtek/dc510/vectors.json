{
  "uplink": [
    {
      "description": "Event-trigger telemetry frame (TTN example bytes)",
      "input": {
        "fPort": 3,
        "bytes": [128, 0, 21, 1, 18, 0, 5, 0, 20, 0, 0, 16, 0, 1, 164, 0, 1, 129]
      },
      "expected": {
        "data": {
          "make": "dingtek",
          "model": "dc510",
          "people": { "total": 5 },
          "air": { "temperature": 20 },
          "countAlarm": true,
          "batteryAlarm": false,
          "battery": 4.2,
          "frameCounter": 1
        }
      },
      "source": "ttn-example"
    },
    {
      "description": "Parameter confirmation frame carries no measurement (error)",
      "input": {
        "fPort": 3,
        "bytes": [80, 0, 21, 3, 13, 1, 3, 4, 1, 244, 20, 1, 129]
      },
      "expected": { "errors": ["parameter confirmation frame"] },
      "source": "ttn-example"
    },
    {
      "description": "Unsupported fPort returns an error",
      "input": {
        "fPort": 1,
        "bytes": [128, 0, 21, 1, 18, 0, 5, 0, 20, 0, 0, 16, 0, 1, 164, 0, 1, 129]
      },
      "expected": { "errors": ["unknown FPort"] },
      "source": "synthetic"
    }
  ],
  "downlink": []
}
